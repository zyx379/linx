# ============================================================
# linx 现场配置示例 — 复制为 linx.env 后修改
# 结构兼容 zoe-his-mcp/.env，可直接迁移各项目配置
# 首次启动会把这些 env 作为「种子」写入 linx-data/config.json，
# 之后以运维界面(/admin)的编辑为准。
# ============================================================

# ===== 服务 =====
LINX_PORT=8080
# 对外 relay 的 API Key（本地 zoe-his-mcp 用 Bearer 携带）。留空则首启动自动生成。
LINX_API_KEY=
# 运维界面登录口令。留空则首启动使用默认口令 123。
LINX_ADMIN_PASSWORD=123
# 来源 IP 白名单，逗号分隔，留空=不限制
LINX_IP_WHITELIST=
# 公网出口 IP 探测源
LINX_PUBLIC_IP_ECHO=https://api.ipify.org
# 运维界面是否仅允许本机访问（true=仅 127.0.0.1 可进 /admin）
LINX_ADMIN_LOCAL_ONLY=true
# 数据目录（配置/密钥落地），留空=可执行文件同级 linx-data
LINX_DATA_DIR=

# ===== Oracle Instant Client（relay/db Thick 模式，必配 Oracle 项目）=====
# node-oracledb Thin 不支持 12c 密码校验 (NJS-116 / verifier 0x939)，须安装 IC 并指定目录后重启 linx。
# 下载: https://www.oracle.com/database/technologies/instant-client/downloads.html
# Windows 解压例: C:\oracle\instantclient_19_24  （目录内须有 oci.dll）
# Linux 解压例: /opt/oracle/instantclient_19_24
# 留空则尝试从系统 PATH 查找 Instant Client（不推荐生产）
LINX_ORACLE_CLIENT_LIB_DIR=

# ===== 通用（所有项目共享，可被项目配置覆盖）=====
ZOE_API_LOG_PATH=/log-manage-service/log/search

# ============================================================
# 各项目配置（格式: ZOE_<code>_* 与 ZOE_DB_<code>_*）
# ============================================================

# ===== seyy（公司库，示例）=====
ZOE_seyy_API_BASE_URL=http://192.168.5.24:8081
# 日志平台 token：二选一
#   1) 静态 token：ZOE_seyy_API_TOKEN=xxxx
#   2) 从内网 Redis 取（需 ioredis）：配置下方 REDIS_*
ZOE_seyy_REDIS_HOST=192.168.5.22
ZOE_seyy_REDIS_PORT=6379
ZOE_seyy_REDIS_PASSWORD=
ZOE_seyy_REDIS_DB=0
ZOE_DB_seyy_TYPE=oracle
ZOE_DB_seyy_HOST=192.168.3.209
ZOE_DB_seyy_PORT=1521
ZOE_DB_seyy_USERNAME=
ZOE_DB_seyy_PASSWORD=
ZOE_DB_seyy_SERVICE_NAME=SEYYMDB
ZOE_DB_seyy_SID=
ZOE_DB_seyy_SCHEMA=

# ===== nasyy（南安市医院，示例 legacy 日志架构）=====
