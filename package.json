{
  "name": "linx",
  "version": "0.1.0",
  "description": "linx — 现场内网出口代理(relay) + 运维界面，供本地 zoe-his-mcp 远程排查医院内网（无 LLM/无问答）",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "linx": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/prebuild-check.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pkg": "npm run build && node scripts/build-pkg-bundle.mjs && npx @yao-pkg/pkg dist/pkg-bundle.cjs --targets node20-win-x64 --output release/linx.exe",
    "pkg:fetch-base": "node scripts/fetch-pkg-base.mjs",
    "test:frp": "node scripts/test-frp-linx.mjs",
    "test:mcp-via-linx": "node scripts/test-mcp-via-linx.mjs",
    "test:mcp-linx": "node mcp/smoke-test.mjs",
    "dist": "node scripts/package-release.mjs",
    "dist:portable": "node scripts/package-portable.mjs"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "optionalDependencies": {
    "dmdb": "^1.0.48286",
    "ioredis": "^5.10.1",
    "oracledb": "^6.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@yao-pkg/pkg": "^6.6.0",
    "esbuild": "^0.25.12",
    "pkg": "^5.8.1",
    "typescript": "^5.9.3"
  },
  "pkg": {
    "scripts": "dist/pkg-bundle.cjs",
    "assets": [
      "web/**/*"
    ],
    "outputPath": "release"
  }
}
